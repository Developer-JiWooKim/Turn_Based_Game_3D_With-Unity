.root {
    width: 100%;
    height: 100%;
    flex-direction: column;
}

.top-area {
    flex-direction: row;
    flex-grow: 1;
    padding: 16px;
    gap: 12px;
}

.preview-area {
    width: 30%;
    background-color: rgba(0, 10, 20, 0.7);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.4);
    border-radius: 4px;
}

.weapon-info {
    width: 25%;
    background-color: rgba(0, 10, 20, 0.7);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.4);
    border-radius: 4px;
    padding: 16px;
    flex-direction: column;
    gap: 8px;
}

.weapon-name {
    font-size: 22px;
    color: rgb(0, 255, 220);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.weapon-stat-row {
    flex-direction: row;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-color: rgba(0, 255, 220, 0.2);
    padding-bottom: 4px;
}

.weapon-stat-label {
    font-size: 13px;
    color: rgba(180, 220, 220, 0.8);
}

.weapon-stat-value {
    font-size: 13px;
    color: rgb(0, 255, 220);
    -unity-font-style: bold;
}

.weapon-desc {
    font-size: 12px;
    color: rgba(180, 200, 200, 0.6);
    margin-top: 8px;
    white-space: normal;
}

.weapon-list {
    flex-grow: 1;
    background-color: rgba(0, 10, 20, 0.7);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.4);
    border-radius: 4px;
    padding: 16px;
    flex-direction: column;
}

.list-title {
    font-size: 14px;
    color: rgba(0, 255, 220, 0.7);
    -unity-font-style: bold;
    margin-bottom: 12px;
    letter-spacing: 2px;
}

.weapon-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
}

.bottom-area {
    flex-direction: row;
    height: 200px;
    padding: 12px 32px;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(0, 5, 15, 0.8);
    border-top-width: 1px;
    border-color: rgba(0, 255, 220, 0.3);
}

.selected-weapons-area {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
}

.selected-title {
    font-size: 20px;
    color: rgba(0, 255, 220, 0.6);
    -unity-font-style: bold;
    padding-top: -32px;
    letter-spacing: 2px;
}

.selected-weapons {
    flex-direction: row;
    align-items: center;
    
    gap: 24px;
}

.selected-slot {
    width: 80px;
    height: 80px;
    background-color: rgba(0, 20, 30, 0.6);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.2);
    border-radius: 4px;
    margin-left: 8px;
    margin-right: 8px;
}

.back-btn {
    width: 160px;
    height: 80px;
    background-color: rgba(0, 20, 30, 0.8);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.4);
    border-radius: 4px;
    color: rgba(0, 255, 220, 0.8);
    font-size: 15px;
    margin: 8px;
}

.back-btn:hover {
    background-color: rgba(0, 40, 50, 0.9);
    border-color: rgb(0, 255, 220);
}

.start-btn {
    width: 160px;
    height: 80px;
    background-color: rgba(0, 180, 150, 0.3);
    border-width: 1px;
    border-color: rgb(0, 255, 220);
    border-radius: 4px;
    color: rgb(0, 255, 220);
    font-size: 15px;
    -unity-font-style: bold;
    margin: 8px;
}

.start-btn:hover {
    background-color: rgba(0, 220, 180, 0.4);
}

.select-btn {
    margin-top: auto;
    width: 100%;
    height: 40px;
    background-color: rgba(0, 180, 150, 0.3);
    border-width: 1px;
    border-color: rgb(0, 255, 220);
    border-radius: 4px;
    color: rgb(0, 255, 220);
    font-size: 14px;
    -unity-font-style: bold;
}

.select-btn:hover {
    background-color: rgba(0, 220, 180, 0.4);
}

.weapon-grid-btn-selected {
    border-color: rgb(0, 255, 220);
    border-width: 2px;
    background-color: rgba(0, 60, 80, 0.9);
}

.reset-btn {
    width: 80px;
    height: 30px;
    background-color: rgba(0, 20, 30, 0.8);
    border-width: 1px;
    border-color: rgba(255, 80, 80, 0.6);
    border-radius: 4px;
    color: rgba(255, 80, 80, 0.8);
    font-size: 12px;
    margin-top: 6px;
}

.reset-btn:hover {
    background-color: rgba(255, 80, 80, 0.2);
    border-color: rgb(255, 80, 80);
}