.root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(5, 5, 20);
}

.title-label {
    color: rgb(0, 220, 255);
    font-size: 80px;
    -unity-font-style: bold;
    margin-bottom: 60px;
    /* TODO#: 나중에 폰트 교체 예정 */
}

.button-group {
    flex-direction: column;
    align-items: center;
}

.title-btn {
    width: 300px;
    height: 60px;
    margin: 10px;
    font-size: 24px;
    color: white;
    background-color: rgba(0, 30, 60, 0.85);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(0, 180, 255);
}

.title-btn:hover {
    background-color: rgba(0, 80, 120, 0.95);
    border-color: rgb(0, 220, 255);
}