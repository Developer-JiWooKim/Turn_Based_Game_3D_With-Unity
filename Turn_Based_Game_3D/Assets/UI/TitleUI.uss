.root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
}

.background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.title-label {
    font-size: 48px;
    color: rgb(0, 255, 220);
    -unity-font-style: bold;
    margin-bottom: 48px;
    letter-spacing: 4px;
}

.button-group {
    flex-direction: column;
    align-items: center;
    gap: 16px;
}

.title-btn {
    width: 200px;
    height: 55px;
    background-color: rgba(0, 20, 30, 0.8);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.4);
    border-radius: 4px;
    color: rgba(0, 255, 220, 0.8);
    font-size: 16px;
}

.title-btn:hover {
    background-color: rgba(0, 40, 50, 0.9);
    border-color: rgb(0, 255, 220);
}

.mode-select-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 1);
    align-items: center;
    justify-content: center;
    display: none;
    flex-direction: column;
    gap: 16px;
}

.mode-title {
    font-size: 32px;
    color: rgb(0, 255, 220);
    -unity-font-style: bold;
    margin-bottom: 24px;
    letter-spacing: 4px;
}

.mode-btn {
    width: 200px;
    height: 60px;
    background-color: rgba(0, 20, 30, 0.8);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.4);
    border-radius: 4px;
    color: rgba(0, 255, 220, 0.8);
    font-size: 18px;
    -unity-font-style: bold;
}

.mode-btn:hover {
    background-color: rgba(0, 40, 50, 0.9);
    border-color: rgb(0, 255, 220);
}

.mode-back-btn {
    width: 120px;
    height: 45px;
    background-color: rgba(0, 20, 30, 0.8);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.4);
    border-radius: 4px;
    color: rgba(0, 255, 220, 0.6);
    font-size: 14px;
    margin-top: 16px;
}

.mode-back-btn:hover {
    border-color: rgb(0, 255, 220);
}