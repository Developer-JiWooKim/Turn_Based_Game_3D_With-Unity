.root {
    width: 100%;
    height: 100%;
    flex-direction: column;
}

/* ── 상단 바 ─────────────────────────── */
.top-bar {
    flex-direction: row;
    align-items: center;
    height: 120px;
    padding: 10px 14px;
    background-color: rgba(0,0,0,0.6);
}

/* 현재 턴 패널 */
.current-turn-panel {
    flex-direction: row;
    align-items: center;
    background-color: rgba(20,20,20,0.7);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.15);
    padding: 8px 12px;
    margin-right: 14px;
    min-width: 180px;
}

.turn-label {
    color: white;
    font-size: 16px;
    margin-right: 10px;
    -unity-font-style: bold;
}

.current-portrait {
    width: 70px;
    height: 70px;
    border-radius: 6px;
    background-color: rgba(255,255,255,0.1);
    border-width: 2px;
    border-color: rgb(255,210,60);
}

/* 다음 순서 슬롯 */
.turn-queue {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.queue-slot {
    width: 65px;
    height: 65px;
    border-radius: 6px;
    background-color: rgba(255,255,255,0.08);
    border-width: 1px;
    border-color: rgba(255,255,255,0.2);
    margin-right: 8px;
}

/* 옵션 패널 */
.option-panel {
    flex-direction: row;
    align-items: center;
}

.option-btn {
    width: 72px;
    height: 38px;
    margin-left: 8px;
    font-size: 15px;
    color: white;
    background-color: rgba(40,40,40,0.85);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.2);
}

.option-btn:hover {
    background-color: rgba(80,80,80,0.95);
}

/* ── 중앙 ────────────────────────────── */
.center {
    flex-grow: 1;
}

/* ── 하단 바 ─────────────────────────── */
.bottom-bar {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    height: 150px;
    padding: 12px 20px;
    background-color: rgba(0,0,0,0.6);
}

/* 스킬 바 */
.skill-bar {
    flex-direction: row;
    align-items: flex-end;
    min-width: 340px; /* 버튼 3개 너비 고정 */
}

.skill-btn {
    width: 100px;
    height: 100px;
    margin-right: 10px;
    font-size: 14px;
    color: white;
    background-color: rgba(30,30,30,0.85);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.2);
}

.skill-btn:hover {
    background-color: rgba(70,70,70,0.95);
    border-color: rgb(255,210,60);
}

.skill-btn:disabled {
    opacity: 0.35;
}

/* 플레이어 HP/MP */
.player-status {
    background-color: rgba(0,0,0,0.55);
    border-radius: 10px;
    padding: 12px 16px;
    min-width: 280px;
    align-self: flex-end;
}

.player-name {
    color: rgb(255,210,60);
    font-size: 17px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.bar-label {
    color: white;
    font-size: 13px;
    width: 24px;
}

.bar-bg {
    flex-grow: 1;
    height: 14px;
    border-radius: 7px;
    background-color: rgba(255,255,255,0.12);
    margin: 0 8px;
    overflow: hidden;
}

.bar {
    height: 100%;
    border-radius: 7px;
    width: 100%;
}

.hp-bar {
    background-color: rgb(50,200,70);
}

.mp-bar {
    background-color: rgb(50,120,255);
}

.bar-text {
    color: white;
    font-size: 12px;
    width: 70px;
}

.result-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
    display: none;
    pointer-events: auto;
}

.result-text {
    color: white;
    font-size: 60px;
    margin-bottom: 30px;
}

.result-btn {
    width: 200px;
    height: 60px;
    font-size: 24px;
    margin: 10px;
    color: white;
    background-color: rgba(30, 30, 30, 0.85);
    border-radius: 8px;
    border-color: rgba(255, 255, 255, 0.3);
    pointer-events: auto;
}

.exp-bar {
    background-color: rgb(80, 180, 255);
}