<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="TitleUI.uss"/>

    <ui:VisualElement name="root" class="root">

        <!-- 배경 이미지 -->
        <ui:VisualElement name="background" class="background"/>

        <!-- 게임 타이틀 -->
        <ui:Label name="title-label" text="GAME TITLE" class="title-label"/>

        <!-- 버튼 그룹 -->
        <ui:VisualElement name="button-group" class="button-group">
            <ui:Button name="start-btn"  text="게임 시작" class="title-btn"/>
            <ui:Button name="option-btn" text="옵션"     class="title-btn"/>
            <ui:Button name="quit-btn"   text="종료"     class="title-btn"/>
        </ui:VisualElement>

        <!-- 모드 선택 패널 (기본 숨김) -->
        <ui:VisualElement name="mode-select-panel" class="mode-select-panel">
            <ui:Label text="MODE SELECT" class="mode-title"/>
            <ui:Button name="normal-btn"    text="NORMAL"    class="mode-btn"/>
            <ui:Button name="challenge-btn" text="CHALLENGE" class="mode-btn"/>
            <ui:Button name="mode-back-btn" text="BACK"      class="mode-back-btn"/>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>