.root {
    width: 100%;
    height: 100%;
    flex-direction: column;
}

.character-select-area {
    width: 100%;
    height: 100%;
    flex-direction: column;
}

.top-area {
    flex-direction: row;
    flex-grow: 1;
    padding: 16px;
    gap: 12px;
}

.preview-area {
    width: 30%;
    background-color: rgba(0, 10, 20, 0.7);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.4);
    border-radius: 4px;
}

.character-info {
    width: 25%;
    background-color: rgba(0, 10, 20, 0.7);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.4);
    border-radius: 4px;
    padding: 16px;
    flex-direction: column;
    gap: 8px;
}

.character-name {
    font-size: 22px;
    color: rgb(0, 255, 220);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.character-stat-row {
    flex-direction: row;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-color: rgba(0, 255, 220, 0.2);
    padding-bottom: 4px;
}

.character-stat-label {
    font-size: 13px;
    color: rgba(180, 220, 220, 0.8);
}

.character-stat-value {
    font-size: 13px;
    color: rgb(0, 255, 220);
    -unity-font-style: bold;
}

.character-list {
    flex-grow: 1;
    background-color: rgba(0, 10, 20, 0.7);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.4);
    border-radius: 4px;
    padding: 16px;
    flex-direction: column;
}

.list-title {
    font-size: 14px;
    color: rgba(0, 255, 220, 0.7);
    -unity-font-style: bold;
    margin-bottom: 12px;
    letter-spacing: 2px;
}

.character-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
}

.character-grid-btn {
    width: 80px;
    height: 80px;
    background-color: rgba(0, 20, 30, 0.8);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.3);
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;

    color: white;
    font-size: 11px;
}

.character-grid-btn:hover {
    border-color: rgba(0, 255, 220, 0.8);
    background-color: rgba(0, 40, 50, 0.9);
}

.character-grid-btn-selected {
    border-color: rgb(0, 255, 220);
    border-width: 2px;
    background-color: rgba(0, 60, 80, 0.9);
}

.bottom-area {
    flex-direction: row;
    height: 200px;
    padding: 12px 32px;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(0, 5, 15, 0.8);
    border-top-width: 1px;
    border-color: rgba(0, 255, 220, 0.3);
}

.back-btn {
    width: 160px;
    height: 80px;
    background-color: rgba(0, 20, 30, 0.8);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.4);
    border-radius: 4px;
    color: rgba(0, 255, 220, 0.8);
    font-size: 15px;
    margin: 8px;
}

.back-btn:hover {
    background-color: rgba(0, 40, 50, 0.9);
    border-color: rgb(0, 255, 220);
}

.start-btn {
    width: 160px;
    height: 80px;
    background-color: rgba(0, 180, 150, 0.3);
    border-width: 1px;
    border-color: rgb(0, 255, 220);
    border-radius: 4px;
    color: rgb(0, 255, 220);
    font-size: 15px;
    -unity-font-style: bold;
    margin: 8px;
}

.start-btn:hover {
    background-color: rgba(0, 220, 180, 0.4);
}

.reset-btn {
    width: 160px;
    height: 80px;
    background-color: rgba(0, 20, 30, 0.8);
    border-width: 1px;
    border-color: rgba(255, 80, 80, 0.6);
    border-radius: 4px;
    color: rgba(255, 80, 80, 0.8);
    font-size: 15px;
    margin: 8px;
}

.reset-btn:hover {
    background-color: rgba(255, 80, 80, 0.2);
    border-color: rgb(255, 80, 80);
}

.weight-allocation-panel {
    display: none;
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 5, 15, 0.95);
    flex-direction: column;
    align-items: center;
    padding: 32px;
}

.panel-title {
    font-size: 24px;
    color: rgb(0, 255, 220);
    -unity-font-style: bold;
    margin-bottom: 16px;
    letter-spacing: 2px;
}

.remaining-points-row {
    flex-direction: row;
    gap: 12px;
    margin-bottom: 16px;
}

.category-list {
    width: 60%;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
}

.category-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(0, 10, 20, 0.7);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.3);
    border-radius: 4px;
    padding: 8px 16px;
}

.category-name {
    font-size: 14px;
    color: rgba(180, 220, 220, 0.9);
    flex-grow: 1;
}

.category-invested {
    font-size: 14px;
    color: rgb(0, 255, 220);
    -unity-font-style: bold;
    width: 32px;
    -unity-text-align: middle-center;
}

.category-btn {
    width: 32px;
    height: 32px;
    background-color: rgba(0, 20, 30, 0.8);
    border-width: 1px;
    border-color: rgba(0, 255, 220, 0.4);
    border-radius: 4px;
    color: rgb(0, 255, 220);
    font-size: 16px;
    -unity-font-style: bold;
}

.category-btn:hover {
    background-color: rgba(0, 40, 50, 0.9);
}

.weight-panel-buttons {
    flex-direction: row;
    gap: 16px;
    margin-top: 16px;
}
